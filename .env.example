# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Server
PORT=4000
WEB_ORIGIN="http://localhost:3000"
ADMIN_API_KEY="change-me-local-admin-key"

# JWT Auth
JWT_ACCESS_SECRET="generate-a-strong-random-secret"
JWT_REFRESH_SECRET="generate-a-strong-random-secret"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth 2.0 (Passport)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Nodemailer Email OTP (Gmail SMTP)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-gmail-app-password"
MAIL_FROM="VROMON <your-email@gmail.com>"

# AI (LangChain JS + Gemini)
LLM_PROVIDER="google-genai"
LLM_MODEL="gemini-3-flash-preview"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIM=768
GOOGLE_API_KEY="your-gemini-api-key"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
