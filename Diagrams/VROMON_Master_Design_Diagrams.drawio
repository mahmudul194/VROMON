d_at&lt;/b&gt;: &lt;i&gt;TIMESTAMP&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT NOW())&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;shadow=1;points=[[0,0.15],[0,0.35],[0,0.5],[0,0.65],[0,0.85],[1,0.15],[1,0.35],[1,0.5],[1,0.65],[1,0.85],[0.5,0],[0.5,1]];" parent="1" vertex="1">
