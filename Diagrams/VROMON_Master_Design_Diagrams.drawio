        <mxCell id="tbl_monthly_crowds" value="&lt;div style='background-color:#0F172A;color:#FFFFFF;padding:6px;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-weight:bold;font-size:12px;text-align:center;'&gt;monthly_crowds&lt;/div&gt;&lt;div style='padding:6px 8px;font-family:Consolas, monospace;font-size:10.5px;line-height:1.45;text-align:left;background-color:#FFFFFF;color:#0F172A;'&gt;&lt;div style='color:#B45309;font-weight:bold;white-space:nowrap;'&gt;&amp;#128273; &lt;b&gt;crowd_id&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt; &lt;span style='color:#B45309;font-weight:bold;'&gt;[PK]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(AUTO_INCREMENT)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#1D4ED8;font-weight:bold;white-space:nowrap;'&gt;&amp;#128279; &lt;b&gt;destination_id&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt; &lt;span style='color:#1D4ED8;'&gt;[FK: destinations.destination_id]&lt;/span&gt; &lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;month_num&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK 1..12)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;base_crowd_level&lt;/b&gt;: &lt;i&gt;VARCHAR(10)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, IN (&amp;#x27;Low&amp;#x27;,&amp;#x27;Med&amp;#x27;,&amp;#x27;High&amp;#x27;))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;holiday_crowd_level&lt;/b&gt;: &lt;i&gt;VARCHAR(10)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, IN (&amp;#x27;Low&amp;#x27;,&amp;#x27;Med&amp;#x27;,&amp;#x27;High&amp;#x27;))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;crowd_factor_score&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK 0..100)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fi