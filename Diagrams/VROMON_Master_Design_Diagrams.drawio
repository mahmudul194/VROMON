        <mxCell id="tbl_itinerary_plans" value="&lt;div style='background-color:#0F172A;color:#FFFFFF;padding:6px;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-weight:bold;font-size:12px;text-align:center;'&gt;itinerary_plans&lt;/div&gt;&lt;div style='padding:6px 8px;font-family:Consolas, monospace;font-size:10.5px;line-height:1.45;text-align:left;background-color:#FFFFFF;color:#0F172A;'&gt;&lt;div style='color:#B45309;font-weight:bold;white-space:nowrap;'&gt;&amp;#128273; &lt;b&gt;itinerary_id&lt;/b&gt;: &lt;i&gt;BIGINT&lt;/i&gt; &lt;span style='color:#B45309;font-weight:bold;'&gt;[PK]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(AUTO_INCREMENT)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#1D4ED8;font-weight:bold;white-space:nowrap;'&gt;&amp;#128279; &lt;b&gt;query_id&lt;/b&gt;: &lt;i&gt;BIGINT&lt;/i&gt; &lt;span style='color:#1D4ED8;'&gt;[FK: travel_queries.query_id]&lt;/span&gt; &lt;/div&gt;&lt;div style='color:#1D4ED8;font-weight:bold;white-space:nowrap;'&gt;&amp;#128279; &lt;b&gt;destination_id&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt; &lt;span style='color:#1D4ED8;'&gt;[FK: destinations.destination_id]&lt;/span&gt; &lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;trip_title&lt;/b&gt;: &lt;i&gt;VARCHAR(150)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;total_estimated_cost_bdt&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;transport_cost_bdt&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;accommodation_cost_bdt&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;food_cost_bdt&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;local_activities_cost_bdt&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;buffer_cost_bdt&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (10%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;share_token&lt;/b&gt;: &lt;i&gt;VARCHAR(32)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, UNIQUE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;share_url&lt;/b&gt;: &lt;i&gt;VARCHAR(255)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;expires_at&lt;/b&gt;: &lt;i&gt;TIMESTAMP&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (30d TTL))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;created_at&lt;/b&gt;: &lt;i&gt;TIMESTAMP&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT NOW())&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;shadow=1;points=[[0,0.15],[0,0.35],[0,0.5],[0,0.65],[0,0.85],[1,0.15],[1,0.35],[1,0.5],[1,0.65],[1,0.85],[0.5,0],[0.5,1]];" parent="1" vertex="1">
