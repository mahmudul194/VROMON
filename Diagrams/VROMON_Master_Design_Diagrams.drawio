        <mxCell id="tbl_destinations" value="&lt;div style='background-color:#0F172A;color:#FFFFFF;padding:6px;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-weight:bold;font-size:12px;text-align:center;'&gt;destinations&lt;/div&gt;&lt;div style='padding:6px 8px;font-family:Consolas, monospace;font-size:10.5px;line-height:1.45;text-align:left;background-color:#FFFFFF;color:#0F172A;'&gt;&lt;div style='color:#B45309;font-weight:bold;white-space:nowrap;'&gt;&amp;#128273; &lt;b&gt;destination_id&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt; &lt;span style='color:#B45309;font-weight:bold;'&gt;[PK]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(AUTO_INCREMENT)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;name_en&lt;/b&gt;: &lt;i&gt;VARCHAR(100)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, UNIQUE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;name_bn&lt;/b&gt;: &lt;i&gt;VARCHAR(100)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;division&lt;/b&gt;: &lt;i&gt;VARCHAR(50)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;district_upazila&lt;/b&gt;: &lt;i&gt;VARCHAR(100)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;latitude&lt;/b&gt;: &lt;i&gt;DECIMAL(9,6)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK -90..90)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;longitude&lt;/b&gt;: &lt;i&gt;DECIMAL(9,6)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK -180..180)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;description&lt;/b&gt;: &lt;i&gt;TEXT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;min_hours_needed&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK &amp;gt; 0)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;cost_tier&lt;/b&gt;: &lt;i&gt;VARCHAR(20)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, IN (&amp;#x27;Budget&amp;#x27;,&amp;#x27;Mod&amp;#x27;,&amp;#x27;Prem&amp;#x27;))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;hotel_rate_per_night&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK &amp;gt;= 0)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;food_rate_per_day&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK &amp;gt;= 0)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;semantic_tags&lt;/b&gt;: &lt;i&gt;JSON&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;embedding_vector&lt;/b&gt;: &lt;i&gt;VECTOR(1536)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;is_active&lt;/b&gt;: &lt;i&gt;BOOLEAN&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT TRUE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;updated_at&lt;/b&gt;: &lt;i&gt;TIMESTAMP&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT NOW())&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;shadow=1;points=[[0,0.15],[0,0.35],[0,0.5],[0,0.65],[0,0.85],[1,0.15],[1,0.35],[1,0.5],[1,0.65],[1,0.85],[0.5,0],[0.5,1]];" parent="1" vertex="1">
