        <mxCell id="legend_box" value="&lt;div style='text-align:left;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-size:11px;color:#0F172A;padding:4px;'&gt;&lt;div style='font-weight:bold;font-size:12px;color:#1E3A8A;border-bottom:1px solid #CBD5E1;padding-bottom:3px;margin-bottom:5px;'&gt;DFD Level 2 Architecture&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;Subprocesses (2.1 - 2.6):&lt;/b&gt; Atomic calculation &amp;amp; scoring steps&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;Data Stores (D1 - D4):&lt;/b&gt; Persistent database sources accessed by engine&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;Formula Callouts:&lt;/b&gt; Exact mathematical models for cost, time, and scoring&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;Interface Boundaries:&lt;/b&gt; Strictly balanced with inputs/outputs of Level 1 Process 2.0&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;html=1;whiteSpace=wrap;shadow=1;" parent="1" vertex="1">
