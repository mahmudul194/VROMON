r:#64748B;'&gt;(NOT NULL (15%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;budget_fit_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (20%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;time_fit_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (10%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;weather_fit_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (15%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;crowd_fit_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (10%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;total_trip_cost_est&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;travel_hours_roundtrip&lt;/b&gt;: &lt;i&gt;DECIMAL(4,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;available_hours_at_dest&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;feasibility_status&lt;/b&gt;: &lt;i&gt;VARCHAR(20)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, IN (&amp;#x27;Fits&amp;#x27;,&amp;#x27;Tight&amp;#x27;,&amp;#x27;Over&amp;#x27;))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;rank_position&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&