atus&lt;/b&gt;: &lt;i&gt;VARCHAR(20)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, IN (&amp;#x27;Completed&amp;#x27;,&amp;#x27;Failed&amp;#x27;,&amp;#x27;Partial&amp;#x27;))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;execution_latency_sec&lt;/b&gt;: &lt;i&gt;DECIMAL(6,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;ingested_at&lt;/b&gt;: &lt;i&gt;TIMESTAMP&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT NOW())&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;shadow=1;points=[[0,0.15],[0,0.35],[0,0.5],[0,0.65],[0,0.85],[1,0.15],[1,0.35],[1,0.5],[1,0.65],[1,0.85],[0.5,0],[0.5,1]];" parent="1" vertex="1">
