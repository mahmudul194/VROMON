        <mxCell id="header_banner" value="&lt;div style='text-align:left;font-family:Segoe UI, Helvetica, Arial, sans-serif;color:#0F172A;'&gt;&lt;div style='font-size:20px;font-weight:bold;color:#1E3A8A;'&gt;Component C: Data Flow Diagram — Level 2 DFD (Process 2.0 Decomposition)&lt;/div&gt;&lt;div style='font-size:12px;color:#475569;margin-top:4px;'&gt;Detailed internal architecture of Process 2.0: Feasibility Calculation &amp;amp; Multi-Factor Recommendation Engine.&lt;/div&gt;&lt;div style='font-size:11px;color:#64748B;margin-top:2px;'&gt;&lt;b&gt;Project:&lt;/b&gt; VROMON — Bangladesh Smart Trip Feasibility &amp;amp; Risk-Aware Travel Recommender | &lt;b&gt;Course:&lt;/b&gt; SE331 Software Engineering Design Capstone Project | &lt;b&gt;Semester:&lt;/b&gt; Fall 2026 | &lt;b&gt;Institution:&lt;/b&gt; Daffodil International University&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;html=1;whiteSpace=wrap;" parent="1" vertex="1">
