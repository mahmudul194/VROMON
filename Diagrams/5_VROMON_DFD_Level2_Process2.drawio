        <mxCell id="callout_18348" value="&lt;div style='text-align:left;font-family:Segoe UI, Helvetica, Arial, sans-serif;padding:6px;'&gt;&lt;div style='font-size:12px;font-weight:bold;color:#14532D;border-bottom:1px solid #BBF7D0;padding-bottom:3px;margin-bottom:5px;'&gt;Budget Feasibility Mathematical Model&lt;/div&gt;&lt;div style='font-size:10px;line-height:1.45;color:#0F172A;'&gt;&lt;b&gt;Accommodation:&lt;/b&gt; ceil(travelers / 2) &amp;times; (days &amp;minus; 1) &amp;times; hotel_rate&lt;br/&gt;&lt;b&gt;Food:&lt;/b&gt; travelers &amp;times; days &amp;times; daily_food_rate&lt;br/&gt;&lt;b&gt;Transport:&lt;/b&gt; cheapest_fare &amp;times; 2 &amp;times; travelers&lt;br/&gt;&lt;b&gt;Subtotal:&lt;/b&gt; Transport + Stay + Food + Local POI Fees&lt;br/&gt;&lt;b&gt;Total Cost:&lt;/b&gt; Subtotal + 10% Extra Buffer&lt;br/&gt;&lt;hr style='border:none;border-top:1px solid #BBF7D0;margin:3px 0;'/&gt;&lt;b&gt;Tiers:&lt;/b&gt;&lt;br/&gt;&amp;#8226; &lt;b&gt;Fits:&lt;/b&gt; Total &amp;le; Budget (Score = 100)&lt;br/&gt;&amp;#8226; &lt;b&gt;Tight:&lt;/b&gt; Budget &amp;lt; Total &amp;le; 1.10&amp;times;Budget (Score = 70-99)&lt;br/&gt;&amp;#8226; &lt;b&gt;Over:&lt;/b&gt; 1.10&amp;times;Budget &amp;lt; Total &amp;le; 1.25&amp;times;Budget (Score = 0-69)&lt;br/&gt;&amp;#8226; &lt;b&gt;Discard:&lt;/b&gt; Total &amp;gt; 1.25&amp;times;Budget (Excluded)&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;html=1;whiteSpace=wrap;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="720" width="340" height="220" as="geometry" />
        </mxCell>
        <mxCell id="callout_5819" value="&lt;div style='text-align:left;font-family:Segoe UI, Helvetica, Arial, sans-serif;padding:6px;'&gt;&lt;div style='font-size:12px;font-weight:bold;color:#14532D;border-bottom:1px solid #BBF7D0;padding-bottom:3px;margin-bottom:5px;'&gt;Available Time &amp;amp; Duration Model&lt;/div&gt;&lt;div style='font-size:10px;line-height:1.45;color:#0F172A;'&gt;&lt;b&gt;Daily Usable Hours:&lt;/b&gt; 12 hours/day&lt;br/&gt;&lt;b&gt;Gross Available Hours:&lt;/b&gt; days &amp;times; 12&lt;br/&gt;&lt;b&gt;Hours at Destination:&lt;/b&gt; Gross &amp;minus; Roundtrip_Travel_Hours&lt;br/&gt;&lt;hr style='border:none;border-top:1px solid #BBF7D0;margin:3px 0;'/&gt;&lt;b&gt;Time Rule:&lt;/b&gt;&lt;br/&gt;If Available_Hours &amp;lt; min_hours_needed &amp;rarr; &lt;b&gt;Filter Out&lt;/b&gt;&lt;br/&gt;Else Time_Fit_Score = min(100, (Available / min_needed) &amp;times; 100)&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;html=1;whiteSpace=wrap;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="770" y="720" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="callout_66634" value="&lt;div style='text-align:left;font-family:Segoe UI, Helvetica, Arial, sans-serif;padding:6px;'&gt;&lt;div style='font-size:12px;font-weight:bold;color:#14532D;border-bottom:1px solid #BBF7D0;padding-bottom:3px;margin-bottom:5px;'&gt;Multi-Factor Recommendation Weights&lt;/div&gt;&lt;div style='font-size:10px;line-height:1.45;color:#0F172A;'&gt;&lt;table style='width:100%;font-size:9.5px;border-collapse:collapse;color:#0F172A;'&gt;&lt;tr style='background-color:#DCFCE7;font-weight:bold;'&gt;&lt;td&gt;Factor&lt;/td&gt;&lt;td style='text-align:right;'&gt;Weight&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Meaning Match (AI 2 Vector Cosine)&lt;/td&gt;&lt;td style='text-align:right;font-weight:bold;'&gt;30%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Interest Match (AI 1 Tag Overlap)&lt;/td&gt;&lt;td style='text-align:right;font-weight:bold;'&gt;15%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Budget Fit (Total vs. Budget Cap)&lt;/td&gt;&lt;td style='text-align:right;font-weight:bold;'&gt;20%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Time Fit (Available vs. Min Needed)&lt;/td&gt;&lt;td style='text-align:right;font-weight:bold;'&gt;10%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Weather Fit (Monthly Rating 1-5)&lt;/td&gt;&lt;td style='text-align:right;font-weight:bold;'&gt;15%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Crowd Fit (Low 100, Med 60, High 20)&lt;/td&gt;&lt;td style='text-align:right;font-weight:bold;'&gt;10%&lt;/td&gt;&lt;/tr&gt;&lt;tr style='border-top:1px solid #16A34A;font-weight:bold;'&gt;&lt;td&gt;Total Composite Score&lt;/td&gt;&lt;td style='text-align:right;'&gt;100%&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='margin-top:4px;font-size:9px;color:#166534;'&gt;&lt;i&gt;Alternatives triggered if top 3 results are Over Budget or High Crowd.&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;html=1;whiteSpace=wrap;shadow=1;" parent="1" vertex="1">
