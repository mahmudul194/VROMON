        <mxCell id="proc_21" value="&lt;div style='text-align:center;font-family:Segoe UI, Helvetica, Arial, sans-serif;padding:4px;'&gt;&lt;div style='font-size:13px;font-weight:bold;color:#047857;'&gt;2.1&lt;/div&gt;&lt;div style='font-size:11px;font-weight:bold;color:#0F172A;margin-top:2px;'&gt;Calculate Transport &amp;amp; Travel Time&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;margin-top:2px;'&gt;Select cheapest transit mode (bus/train/launch) &amp;amp; compute roundtrip fare + transit hours&lt;/div&gt;&lt;/div&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fontFamily=Segoe UI;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#059669;shadow=1;" parent="1" vertex="1">
