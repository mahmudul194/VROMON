        <mxCell id="proc_22" value="&lt;div style='text-align:center;font-family:Segoe UI, Helvetica, Arial, sans-serif;padding:4px;'&gt;&lt;div style='font-size:13px;font-weight:bold;color:#047857;'&gt;2.2&lt;/div&gt;&lt;div style='font-size:11px;font-weight:bold;color:#0F172A;margin-top:2px;'&gt;Calculate Time Feasibility&lt;/div&gt;&lt;div style='font-size:9.5px;color:#334155;margin-top:2px;'&gt;usable_hours = (days * 12) - travel_hours. Filter if &amp;lt; min_hours_needed &amp;amp; score time fit&lt;/div&gt;&lt;/div&gt;" style="shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fontFamily=Segoe UI;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#059669;shadow=1;" parent="1" vertex="1">
