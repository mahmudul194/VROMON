        <mxCell id="tbl_data_ingestion_logs" value="&lt;div style='background-color:#334155;color:#FFFFFF;padding:6px;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-weight:bold;font-size:12px;text-align:center;'&gt;data_ingestion_logs&lt;/div&gt;&lt;div style='padding:6px 8px;font-family:Consolas, monospace;font-size:10.5px;line-height:1.45;text-align:left;background-color:#FFFFFF;color:#0F172A;'&gt;&lt;div style='color:#B45309;font-weight:bold;white-space:nowrap;'&gt;&amp;#128273; &lt;b&gt;log_id&lt;/b&gt;: &lt;i&gt;BIGINT&lt;/i&gt; &lt;span style='color:#B45309;font-weight:bold;'&gt;[PK]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(AUTO_INCREMENT)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#1D4ED8;font-weight:bold;white-space:nowrap;'&gt;&amp;#128279; &lt;b&gt;admin_id&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt; &lt;span style='color:#1D4ED8;'&gt;[FK: admin_users.admin_id]&lt;/span&gt; &lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;source_filename&lt;/b&gt;: &lt;i&gt;VARCHAR(150)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;records_count&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;valid_records_count&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;invalid_records_count&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;vector_index_count&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;ingestion_st