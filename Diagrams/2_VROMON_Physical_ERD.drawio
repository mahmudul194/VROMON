  <diagram id="page_physical_erd" name="Physical ERD / Schema (Component B)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1350" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_banner" value="&lt;div style='text-align:left;font-family:Segoe UI, Helvetica, Arial, sans-serif;color:#0F172A;'&gt;&lt;div style='font-size:20px;font-weight:bold;color:#1E3A8A;'&gt;Component B: Relational Database Schema / Physical ERD&lt;/div&gt;&lt;div style='font-size:12px;color:#475569;margin-top:4px;'&gt;Physical relational tables, SQL data types, Primary/Foreign Keys, referential integrity constraints, and domain checks.&lt;/div&gt;&lt;div style='font-size:11px;color:#64748B;margin-top:2px;'&gt;&lt;b&gt;Project:&lt;/b&gt; VROMON — Bangladesh Smart Trip Feasibility &amp;amp; Risk-Aware Travel Recommender | &lt;b&gt;Course:&lt;/b&gt; SE331 Software Engineering Design Capstone Project | &lt;b&gt;Semester:&lt;/b&gt; Fall 2026 | &lt;b&gt;Institution:&lt;/b&gt; Daffodil International University&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;html=1;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="50" y="30" width="1700" height="75" as="geometry" />
        </mxCell>
        <mxCell id="legend_box" value="&lt;div style='text-align:left;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-size:11px;color:#0F172A;padding:4px;'&gt;&lt;div style='font-weight:bold;font-size:12px;color:#1E3A8A;border-bottom:1px solid #CBD5E1;padding-bottom:3px;margin-bottom:5px;'&gt;Schema &amp;amp; Constraint Legend&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;&amp;#128273; [PK]:&lt;/b&gt; Primary Key (NOT NULL, UNIQUE)&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;&amp;#128279; [FK]:&lt;/b&gt; Foreign Key with referenced table &amp;amp; column&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;Constraints:&lt;/b&gt; NOT NULL, CHECK, DEFAULT, UNIQUE&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;Connectors:&lt;/b&gt; Solid Crow's Foot indicates 1:N Foreign Key relationship&lt;/div&gt;&lt;div style='margin-bottom:3px;'&gt;&lt;b&gt;Data Types:&lt;/b&gt; BIGINT, INT, VARCHAR, DECIMAL, TEXT, JSON, VECTOR(1536)&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;html=1;whiteSpace=wrap;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="1500" y="30" width="350" height="115" as="geometry" />
        </mxCell>
        <mxCell id="tbl_travel_queries" value="&lt;div style='background-color:#0F172A;color:#FFFFFF;padding:6px;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-weight:bold;font-size:12px;text-align:center;'&gt;travel_queries&lt;/div&gt;&lt;div style='padding:6px 8px;font-family:Consolas, monospace;font-size:10.5px;line-height:1.45;text-align:left;background-color:#FFFFFF;color:#0F172A;'&gt;&lt;div style='color:#B45309;font-weight:bold;white-space:nowrap;'&gt;&amp;#128273; &lt;b&gt;query_id&lt;/b&gt;: &lt;i&gt;BIGINT&lt;/i&gt; &lt;span style='color:#B45309;font-weight:bold;'&gt;[PK]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(AUTO_INCREMENT)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;session_token&lt;/b&gt;: &lt;i&gt;VARCHAR(64)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, UNIQUE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;free_text_wishes&lt;/b&gt;: &lt;i&gt;TEXT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;budget_taka&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK &amp;gt;= 1000)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;num_travelers&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK &amp;gt;= 1)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;num_days&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK 1..30)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;travel_month&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK 1..12)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;starting_city&lt;/b&gt;: &lt;i&gt;VARCHAR(50)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;is_weekend_holiday&lt;/b&gt;: &lt;i&gt;BOOLEAN&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT FALSE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;extracted_tags&lt;/b&gt;: &lt;i&gt;JSON&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;extracted_mood&lt;/b&gt;: &lt;i&gt;VARCHAR(100)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;query_vector&lt;/b&gt;: &lt;i&gt;VECTOR(1536)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;created_at&lt;/b&gt;: &lt;i&gt;TIMESTAMP&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT NOW())&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;shadow=1;points=[[0,0.15],[0,0.35],[0,0.5],[0,0.65],[0,0.85],[1,0.15],[1,0.35],[1,0.5],[1,0.65],[1,0.85],[0.5,0],[0.5,1]];" parent="1" vertex="1">
          <mxGeometry x="40" y="160" width="270" height="310" as="geometry" />
        </mxCell>
        <mxCell id="tbl_destinations" value="&lt;div style='background-color:#0F172A;color:#FFFFFF;padding:6px;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-weight:bold;font-size:12px;text-align:center;'&gt;destinations&lt;/div&gt;&lt;div style='padding:6px 8px;font-family:Consolas, monospace;font-size:10.5px;line-height:1.45;text-align:left;background-color:#FFFFFF;color:#0F172A;'&gt;&lt;div style='color:#B45309;font-weight:bold;white-space:nowrap;'&gt;&amp;#128273; &lt;b&gt;destination_id&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt; &lt;span style='color:#B45309;font-weight:bold;'&gt;[PK]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(AUTO_INCREMENT)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;name_en&lt;/b&gt;: &lt;i&gt;VARCHAR(100)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, UNIQUE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;name_bn&lt;/b&gt;: &lt;i&gt;VARCHAR(100)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;division&lt;/b&gt;: &lt;i&gt;VARCHAR(50)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;district_upazila&lt;/b&gt;: &lt;i&gt;VARCHAR(100)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;latitude&lt;/b&gt;: &lt;i&gt;DECIMAL(9,6)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK -90..90)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;longitude&lt;/b&gt;: &lt;i&gt;DECIMAL(9,6)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK -180..180)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;description&lt;/b&gt;: &lt;i&gt;TEXT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;min_hours_needed&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK &amp;gt; 0)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;cost_tier&lt;/b&gt;: &lt;i&gt;VARCHAR(20)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, IN (&amp;#x27;Budget&amp;#x27;,&amp;#x27;Mod&amp;#x27;,&amp;#x27;Prem&amp;#x27;))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;hotel_rate_per_night&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK &amp;gt;= 0)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;food_rate_per_day&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK &amp;gt;= 0)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;semantic_tags&lt;/b&gt;: &lt;i&gt;JSON&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;embedding_vector&lt;/b&gt;: &lt;i&gt;VECTOR(1536)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;is_active&lt;/b&gt;: &lt;i&gt;BOOLEAN&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT TRUE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;updated_at&lt;/b&gt;: &lt;i&gt;TIMESTAMP&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT NOW())&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;shadow=1;points=[[0,0.15],[0,0.35],[0,0.5],[0,0.65],[0,0.85],[1,0.15],[1,0.35],[1,0.5],[1,0.65],[1,0.85],[0.5,0],[0.5,1]];" parent="1" vertex="1">
          <mxGeometry x="850" y="160" width="320" height="370" as="geometry" />
        </mxCell>
        <mxCell id="tbl_recommendation_results" value="&lt;div style='background-color:#0F172A;color:#FFFFFF;padding:6px;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-weight:bold;font-size:12px;text-align:center;'&gt;recommendation_results&lt;/div&gt;&lt;div style='padding:6px 8px;font-family:Consolas, monospace;font-size:10.5px;line-height:1.45;text-align:left;background-color:#FFFFFF;color:#0F172A;'&gt;&lt;div style='color:#B45309;font-weight:bold;white-space:nowrap;'&gt;&amp;#128273; &lt;b&gt;result_id&lt;/b&gt;: &lt;i&gt;BIGINT&lt;/i&gt; &lt;span style='color:#B45309;font-weight:bold;'&gt;[PK]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(AUTO_INCREMENT)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#1D4ED8;font-weight:bold;white-space:nowrap;'&gt;&amp;#128279; &lt;b&gt;query_id&lt;/b&gt;: &lt;i&gt;BIGINT&lt;/i&gt; &lt;span style='color:#1D4ED8;'&gt;[FK: travel_queries.query_id]&lt;/span&gt; &lt;/div&gt;&lt;div style='color:#1D4ED8;font-weight:bold;white-space:nowrap;'&gt;&amp;#128279; &lt;b&gt;destination_id&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt; &lt;span style='color:#1D4ED8;'&gt;[FK: destinations.destination_id]&lt;/span&gt; &lt;/div&gt;&lt;div style='color:#1D4ED8;font-weight:bold;white-space:nowrap;'&gt;&amp;#128279; &lt;b&gt;alt_to_dest_id&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt; &lt;span style='color:#1D4ED8;'&gt;[FK: destinations.destination_id (NULL)]&lt;/span&gt; &lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;final_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, CHECK 0..100)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;meaning_match_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (30%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;interest_match_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (15%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;budget_fit_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (20%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;time_fit_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (10%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;weather_fit_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (15%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;crowd_fit_score&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL (10%))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;total_trip_cost_est&lt;/b&gt;: &lt;i&gt;DECIMAL(10,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;travel_hours_roundtrip&lt;/b&gt;: &lt;i&gt;DECIMAL(4,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;available_hours_at_dest&lt;/b&gt;: &lt;i&gt;DECIMAL(5,2)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;feasibility_status&lt;/b&gt;: &lt;i&gt;VARCHAR(20)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, IN (&amp;#x27;Fits&amp;#x27;,&amp;#x27;Tight&amp;#x27;,&amp;#x27;Over&amp;#x27;))&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;rank_position&lt;/b&gt;: &lt;i&gt;INT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;is_alternative_flag&lt;/b&gt;: &lt;i&gt;BOOLEAN&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT FALSE)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;shadow=1;points=[[0,0.15],[0,0.35],[0,0.5],[0,0.65],[0,0.85],[1,0.15],[1,0.35],[1,0.5],[1,0.65],[1,0.85],[0.5,0],[0.5,1]];" parent="1" vertex="1">
          <mxGeometry x="430" y="160" width="320" height="390" as="geometry" />
        </mxCell>
        <mxCell id="tbl_ai_explanations" value="&lt;div style='background-color:#0F172A;color:#FFFFFF;padding:6px;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-weight:bold;font-size:12px;text-align:center;'&gt;ai_explanations&lt;/div&gt;&lt;div style='padding:6px 8px;font-family:Consolas, monospace;font-size:10.5px;line-height:1.45;text-align:left;background-color:#FFFFFF;color:#0F172A;'&gt;&lt;div style='color:#B45309;font-weight:bold;white-space:nowrap;'&gt;&amp;#128273; &lt;b&gt;explanation_id&lt;/b&gt;: &lt;i&gt;BIGINT&lt;/i&gt; &lt;span style='color:#B45309;font-weight:bold;'&gt;[PK]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(AUTO_INCREMENT)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#1D4ED8;font-weight:bold;white-space:nowrap;'&gt;&amp;#128279; &lt;b&gt;result_id&lt;/b&gt;: &lt;i&gt;BIGINT&lt;/i&gt; &lt;span style='color:#1D4ED8;'&gt;[FK: recommendation_results.result_id]&lt;/span&gt;  &lt;span style='color:#64748B;'&gt;(UNIQUE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;match_summary_reason&lt;/b&gt;: &lt;i&gt;TEXT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;tradeoffs_and_watchouts&lt;/b&gt;: &lt;i&gt;TEXT&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NULL)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;generated_by_model&lt;/b&gt;: &lt;i&gt;VARCHAR(50)&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT &amp;#x27;Gemini&amp;#x27;)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;is_fallback_template&lt;/b&gt;: &lt;i&gt;BOOLEAN&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT FALSE)&lt;/span&gt;&lt;/div&gt;&lt;div style='color:#0F172A;white-space:nowrap;'&gt;&amp;#8226; &lt;b&gt;created_at&lt;/b&gt;: &lt;i&gt;TIMESTAMP&lt;/i&gt;  &lt;span style='color:#64748B;'&gt;(NOT NULL, DEFAULT NOW())&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=rectangle;rounded=1;arcSize=4;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;shadow=1;points=[[0,0.15],[0,0.35],[0,0.5],[0,0.65],[0,0.85],[1,0.15],[1,0.35],[1,0.5],[1,0.65],[1,0.85],[0.5,0],[0.5,1]];" parent="1" vertex="1">
